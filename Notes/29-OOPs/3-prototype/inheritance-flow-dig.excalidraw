    {
      "id": "jNvOxDU-axXN3eBY_nH-q",
      "type": "text",
      "x": 66.32611685876259,
      "y": 679.7438487026822,
      "width": 438.2996258409106,
      "height": 66.56566801009959,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
