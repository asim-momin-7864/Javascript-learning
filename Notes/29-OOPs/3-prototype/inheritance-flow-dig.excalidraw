      "index": "ae",
      "roundness": null,
      "seed": 1991376965,
      "version": 86,
      "versionNonce": 101168907,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769852374054,
      "link": null,
      "locked": false,
      "text": "So, the flow of finding parents prototype or prototype look-up ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "So, the flow of finding parents prototype or prototype look-up ",
